# copy to .env. The Privatemode proxy encrypts requests, so it must run on this
# machine: everything between the app and the proxy is plaintext. docker compose
# starts its own proxy and ignores DECISIONS_BASE_URL. The demo sends every
# visitor's questions with this one key.
DECISIONS_BASE_URL=http://localhost:8082/v1
DECISIONS_API_KEY=your-privatemode-api-key
